# Puerto del servicio
PORT=3005

# Base de datos
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=esap_db
DB_SCHEMA=internal_disciplinary_control

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=7d

# API Gateway URL
API_GATEWAY_URL=http://localhost:4000

# Auth Service URL
AUTH_SERVICE_URL=http://localhost:3001

# Notification Service URL
NOTIFICATION_SERVICE_URL=http://localhost:3009

# Environment
NODE_ENV=development

# Storage
# Ruta base para /files/upload. Puede ser absoluta para un disco/volumen dedicado.
# Ejemplo: DISCIPLINARY_STORAGE_PATH=/mnt/disco-control-disciplinario
DISCIPLINARY_STORAGE_PATH=./uploads
