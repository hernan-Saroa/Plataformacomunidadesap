# Puerto del microservicio RUND
PORT=3016

# API interna de consulta de Carpeta Digital. Mismo valor configurado en auth-service.
# Si no se define, admite INTERNAL_SERVICE_TOKEN explícito; nunca JWT_SECRET.
RUND_CARPETA_INTERNAL_TOKEN=
# Aplicar Auth 668 / RUND 007 antes de activar en ambos servicios.
# Reconciliación automática: lotes de hasta 25 personas, ciclo cada 60 s.
RUND_CARPETA_SYNC_ENABLED=false
RUND_CARPETA_SYNC_TOKEN=

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=esap_db
DB_SCHEMA=rund

# JWT (mismo secreto que el resto de servicios). Obligatorio cuando NODE_ENV=production.
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Rutas públicas adicionales (regex separadas por coma). Autogestión docente / macro-docente externo.
JWT_PUBLIC_PATHS=

# Token compartido para las rutas servicio->servicio (/internal/rund/v1). Mismo valor en auth-service,
# academic-work-plan-service y academic-schedule-service. Obligatorio cuando NODE_ENV=production.
INTERNAL_SERVICE_TOKEN=

# Integraciones de servicios
API_GATEWAY_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3001
# Identidad (documento/alias) y listado de usuarios: URL interna directa de Auth.
# Desplegar primero la API interna de identidad de Auth; no usar una URL pública del gateway.
# Debe coincidir con la credencial que auth acepta en x-internal-service-token.
# RUND no deriva esta credencial automáticamente de JWT_SECRET.
AUTH_INTERNAL_SERVICE_TOKEN=
# También se usa para los catálogos internos seccionales/territoriales-banco de Auth.
# Catálogo territorial de PTA (URL interna directa; desplegar su API antes que RUND).
ACADEMIC_WORK_PLAN_SERVICE_URL=http://localhost:3003
# Incluye el período activo para lotes que traigan filas sin período ni valor general.
# Si no se define, usa INTERNAL_SERVICE_TOKEN explícito. Debe coincidir con el de PTA.
PTA_INTERNAL_SERVICE_TOKEN=
RUND_AUTH_SYNC_TIMEOUT_MS=15000
RUND_AUTH_SYNC_MAX_PAGES=1000
NOTIFICATIONS_SERVICE_URL=http://localhost:3009
# URL pública del frontend (links en correos de autogestión RUND y accesos externos)
PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Autogestión docente
RUND_ENABLE_DEV_OTP=false

# Soportes documentales (se guardan en ./uploads; montar volumen en /app/uploads)
# Compose DEV/QA/PRE/PROD/LOCAL: volumen Docker independiente por ambiente.
# Compose base/backend: bind mount existente, configurable desde el entorno de Compose:
# RUND_UPLOADS_HOST_PATH=./backend/rund-service/uploads
# Las variables de environment en Compose prevalecen sobre este env_file.
# Para contenedores, configurar OpenKM/OCR y URLs públicas en el .env del ambiente.
# Opcional. Si se define, PISA el límite propio de cada categoría de documento (por defecto 10 MB).
# RUND_DOCUMENT_MAX_SIZE_BYTES=
# Opcional. Sin definir: disco local permitido salvo en producción (ahí exige OpenKM). No poner true en producción.
# RUND_DOCUMENT_ALLOW_LOCAL=
# Almacenamiento alterno opcional
OPENKM_BASE_URL=
OPENKM_USERNAME=
OPENKM_PASSWORD=
OPENKM_TIMEOUT_MS=15000

# Extracción OCR/IA (backend/rund-ocr-service)
RUND_OCR_ENABLED=false
RUND_OCR_URL=
RUND_OCR_TOKEN=
RUND_OLLAMA_URL=
RUND_OLLAMA_MODEL=

# Confirmación OCR de datos de identidad (documento, tipo, nombre, género, nacimiento): su propietario es Auth.
# true = RUND no escribe en auth.personas; coordina con Auth por API y un diario durable (migración 022 aquí y 672 en Auth).
# Requisitos antes de activar: aplicar 672 en Auth, publicar Auth con /internal/rund/v1/personas/correcciones y luego RUND.
# Con false se conserva el flujo anterior (SQL directo), que necesita que el trigger de cédula de Auth acepte la sugerencia en rund (672).
RUND_OCR_IDENTITY_VIA_AUTH_API=false
# Conciliador de correcciones a medias: segundos de inactividad antes de resolverlas y cada cuánto corre (ms).
#RUND_OCR_IDENTITY_IDLE_SECONDS=120
#RUND_OCR_IDENTITY_RECONCILE_MS=60000
# Escritura de identidad (altas, ediciones, cargas y autogestión) por API de Auth con intención durable.
# true = RUND no escribe en auth.personas/user/role: Auth aplica por API y RUND confirma el perfil en un commit nativo.
# Requiere en Auth: migraciones 669-672 y su API /internal/rund/v1/personas/escritura/operaciones; publicar Auth antes que RUND.
# Aplicar también la migración RUND 023 para conservar autogestión parcial sin período en el coordinador.
# Con true no hay alternativa SQL: un contexto inválido devuelve 400 y un escritor ausente o una transacción externa devuelve 503.
# La edición con sugerencias usa precondición de identidad en Auth y commit nativo de perfil/sugerencias/auditoría.
# Publicar primero el Auth que admite identidadEsperada; el preview continúa siendo solo lectura.
RUND_IDENTITY_WRITE_VIA_AUTH_API=false
# Recuperador de intenciones a medias: segundos de inactividad antes de actuar y cada cuánto corre (ms).
#RUND_IDENTITY_WRITE_IDLE_SECONDS=120
#RUND_IDENTITY_WRITE_RECOVERY_MS=60000

# Secreto del HMAC con el que se guarda el OTP de autogestión (por defecto JWT_SECRET).
#RUND_OTP_SECRET=

NODE_ENV=development
