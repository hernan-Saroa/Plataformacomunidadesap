# Puerto del microservicio RUND
PORT=3016

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=esap_db
DB_SCHEMA=rund

# JWT Configuration
JWT_SECRET=esap-super-secret-jwt-key-2024
JWT_EXPIRES_IN=1d

# Integraciones de servicios
API_GATEWAY_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3009

# Storage para documentos y soportes
RUND_STORAGE_PATH=./uploads

# Environment
NODE_ENV=development
