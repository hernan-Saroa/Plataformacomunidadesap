# Puerto del microservicio RUND
PORT=3016

# API interna de consulta de Carpeta Digital. Mismo valor configurado en auth-service.
# Si no se define, admite INTERNAL_SERVICE_TOKEN explícito; nunca JWT_SECRET.
RUND_CARPETA_INTERNAL_TOKEN=
# Aplicar Auth 668 / RUND 007 antes de activar en ambos servicios.
# Reconciliación automática: lotes de hasta 25 personas, ciclo cada 60 s.
RUND_CARPETA_SYNC_ENABLED=false
RUND_CARPETA_SYNC_TOKEN=

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=esap_db
DB_SCHEMA=rund

# JWT (mismo secreto que el resto de servicios). Obligatorio cuando NODE_ENV=production.
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Rutas públicas adicionales (regex separadas por coma). Autogestión docente / macro-docente externo.
JWT_PUBLIC_PATHS=

# Token compartido para las rutas servicio->servicio (/internal/rund/v1). Mismo valor en auth-service,
# academic-work-plan-service y academic-schedule-service. Obligatorio cuando NODE_ENV=production.
INTERNAL_SERVICE_TOKEN=

# Integraciones de servicios
API_GATEWAY_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3001
# Debe coincidir con la credencial que auth acepta en x-internal-service-token.
# RUND no deriva esta credencial automáticamente de JWT_SECRET.
AUTH_INTERNAL_SERVICE_TOKEN=
RUND_AUTH_SYNC_TIMEOUT_MS=15000
RUND_AUTH_SYNC_MAX_PAGES=1000
NOTIFICATIONS_SERVICE_URL=http://localhost:3009
# URL pública del frontend (links en correos de autogestión RUND y accesos externos)
PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Autogestión docente
RUND_ENABLE_DEV_OTP=false

# Soportes documentales (se guardan en ./uploads; montar volumen en /app/uploads)
# Compose DEV/QA/PRE/PROD/LOCAL: volumen Docker independiente por ambiente.
# Compose base/backend: bind mount existente, configurable desde el entorno de Compose:
# RUND_UPLOADS_HOST_PATH=./backend/rund-service/uploads
# Las variables de environment en Compose prevalecen sobre este env_file.
# Para contenedores, configurar OpenKM/OCR y URLs públicas en el .env del ambiente.
# Opcional. Si se define, PISA el límite propio de cada categoría de documento (por defecto 10 MB).
# RUND_DOCUMENT_MAX_SIZE_BYTES=
# Opcional. Sin definir: disco local permitido salvo en producción (ahí exige OpenKM). No poner true en producción.
# RUND_DOCUMENT_ALLOW_LOCAL=
# Almacenamiento alterno opcional
OPENKM_BASE_URL=
OPENKM_USERNAME=
OPENKM_PASSWORD=
OPENKM_TIMEOUT_MS=15000

# Extracción OCR/IA (backend/rund-ocr-service)
RUND_OCR_ENABLED=false
RUND_OCR_URL=
RUND_OCR_TOKEN=
RUND_OLLAMA_URL=
RUND_OLLAMA_MODEL=

NODE_ENV=development
