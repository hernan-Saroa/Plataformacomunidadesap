# Puerto del servicio
PORT=3004

# Base de datos
DATABASE_URL=postgresql://username:password@localhost:5432/certification_db

# Email Configuration (para recuperación de contraseña, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
SMTP_FROM="ESAP Certificados <no-reply@esap.edu.co>"

# API Gateway URL
API_GATEWAY_URL=http://localhost:3000

# Auth Service URL
AUTH_SERVICE_URL=http://localhost:3001

# Notification Service URL
NOTIFICATION_SERVICE_URL=http://localhost:3009

# Storage Configuration (para certificados PDF, etc.)
STORAGE_TYPE=local
STORAGE_PATH=./uploads/certificates
# Para cloud storage (AWS S3, etc.)
# AWS_S3_BUCKET=certificates-bucket
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# Environment
NODE_ENV=development

# -------------------------------------------------------------------
# Variables usadas por el frontend (Vite) relacionadas con certificados
# * No afectan al servicio NestJS, pero las dejamos documentadas aquí
#   para que el equipo tenga un único punto de referencia.
# -------------------------------------------------------------------
# URL pública del gateway o dominio donde se sirve el API (para llamadas frontend)
VITE_API_URL=http://localhost:3000
# URL pública del microservicio de certificados (para cargar logos/firmas desde /uploads)
VITE_CERTIFICADOS_URL=http://localhost:3004
# URL pública del frontend (para construir los enlaces/QR de verificación)
VITE_PUBLIC_FRONTEND_URL=http://localhost:3000
