PORT=3015
NODE_ENV=development

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=esap_db
DB_SCHEMA=chatbot

# JWT: obligatorio; usar exactamente el mismo secreto del servicio de autenticación.
JWT_SECRET=

# CORS
# Orígenes explícitos para acceso directo desde el navegador (el gateway no lo requiere).
CORS_ORIGIN=http://localhost:3000,http://localhost:3118

# Isolución: fuente SQL Server independiente de PostgreSQL y RUND.
# La conexión y la búsqueda se habilitan por separado.
CHATBOT_ISOLUCION_ENABLED=false
CHATBOT_ISOLUCION_SERVER=172.16.202.145
CHATBOT_ISOLUCION_PORT=1433
CHATBOT_ISOLUCION_DATABASE=Isolucion5Esap
CHATBOT_ISOLUCION_USER=
CHATBOT_ISOLUCION_PASSWORD=
CHATBOT_ISOLUCION_ENCRYPT=true
CHATBOT_ISOLUCION_TRUST_SERVER_CERTIFICATE=false
CHATBOT_ISOLUCION_VIEW=VW_LISTADOMAESTRODOCUMENTOS
# Dejar vacío permite descubrir el esquema; falla si hay varias vistas homónimas.
CHATBOT_ISOLUCION_SCHEMA=
CHATBOT_ISOLUCION_SEARCH_ENABLED=false
# Configurar únicamente después de verificar las columnas reales.
CHATBOT_ISOLUCION_ID_COLUMN=
CHATBOT_ISOLUCION_TITLE_COLUMN=
CHATBOT_ISOLUCION_TEXT_COLUMN=
CHATBOT_ISOLUCION_URL_COLUMN=
CHATBOT_ISOLUCION_VERSION_COLUMN=
# Obligatorio para búsqueda: filtro exacto que limite los documentos autorizados.
# Confirmar que el valor identifica documentos vigentes y aptos para todo usuario
# autenticado del chatbot. No equivale por sí solo a autorización por expediente.
CHATBOT_ISOLUCION_ALLOWED_COLUMN=
CHATBOT_ISOLUCION_ALLOWED_VALUE=
