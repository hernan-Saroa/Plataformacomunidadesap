# Copiar a .env.knowledge (ignorado por Git) o proporcionar un archivo por ambiente.
# Solo contiene variables del chatbot. No modificar RUND_* ni OLLAMA_* globales.
CHATBOT_AI_ENABLED=false
CHATBOT_AI_FAST_MODE=true
# Documento aprobado para el diagnóstico de despliegue, sin generar con Qwen.
CHATBOT_DEPLOY_DOCUMENT_CODE=GF-PT-008
CHATBOT_OLLAMA_MODEL=qwen3.5:9b
# Windows: http://127.0.0.1:11436; Docker con overlay: http://chatbot-ollama:11434
CHATBOT_OLLAMA_URL=http://chatbot-ollama:11434
# Perfil de despliegue: true para la instancia Docker propia; false para IA remota.
CHATBOT_AI_USE_SIDECAR=true
# init genera nombres y puertos distintos para dev, qa, pre y prod.
CHATBOT_AI_NETWORK=esap-chatbot-ai_default
CHATBOT_OLLAMA_BIND_PORT=11436
CHATBOT_AI_TIMEOUT_MS=180000
CHATBOT_AI_CONTEXT_LENGTH=4096
# true si comparte GPU con RUND; false solo con recursos dedicados.
CHATBOT_AI_SHARED_GPU=true
CHATBOT_AI_OCR_OLLAMA_URL=http://host.docker.internal:11434
# En Linux, si Gemma solo se publica en loopback, indique su red Docker existente
# y cambie OCR_OLLAMA_URL a http://rund-ollama:11434. No modifica RUND.
CHATBOT_AI_OCR_NETWORK=

CHATBOT_ISOLUCION_ENABLED=true
CHATBOT_ISOLUCION_SEARCH_ENABLED=true
CHATBOT_ISOLUCION_SERVER=172.16.202.145
CHATBOT_ISOLUCION_PORT=1433
CHATBOT_ISOLUCION_DATABASE=Isolucion5Esap
CHATBOT_ISOLUCION_USER=usrIntegracionIsolucion
# Inyectar con el gestor de secretos del ambiente; nunca versionar la clave.
CHATBOT_ISOLUCION_PASSWORD=
CHATBOT_ISOLUCION_ENCRYPT=true
# Instalar la CA institucional. true solo para la prueba local autorizada.
CHATBOT_ISOLUCION_TRUST_SERVER_CERTIFICATE=false
# Opcional: ruta del certificado PEM en el servidor; se monta solo en el chatbot.
CHATBOT_CA_CERT_FILE=
CHATBOT_ISOLUCION_SCHEMA=dbo
CHATBOT_ISOLUCION_VIEW=VW_LISTADOMAESTRODOCUMENTOS
CHATBOT_ISOLUCION_ID_COLUMN=ID_LISTADOMAESTRODOCUMENTOS
CHATBOT_ISOLUCION_CODE_COLUMN=CODIGO
CHATBOT_ISOLUCION_TITLE_COLUMN=TITULODOCUMENTO
CHATBOT_ISOLUCION_TEXT_COLUMN=TEXTO
CHATBOT_ISOLUCION_TEXT_COLUMNS=TEXTOOBJETIVO,TEXTOALCANCE,TEXTODESARROLLODELPROCESO
CHATBOT_ISOLUCION_PROCESS_COLUMN=PROCESO
CHATBOT_ISOLUCION_URL_COLUMN=URL
CHATBOT_ISOLUCION_VERSION_COLUMN=VERSION
CHATBOT_ISOLUCION_ALLOWED_COLUMN=SYSVERSIONESTADODOCUMENTO
CHATBOT_ISOLUCION_ALLOWED_VALUE=Aprobado
# Política confirmada por el usuario: todos los documentos aprobados son públicos.
CHATBOT_ISOLUCION_PUBLIC_ENABLED=true
CHATBOT_ISOLUCION_PUBLIC_ALLOWED_COLUMN=SYSVERSIONESTADODOCUMENTO
CHATBOT_ISOLUCION_PUBLIC_ALLOWED_VALUE=Aprobado

# Origen verificado con la sesión técnica de consulta autorizada.
CHATBOT_ISOLUCION_FETCH_DOCUMENTS=true
CHATBOT_ISOLUCION_DOCUMENT_BASE_URL=https://isolucion.esap.edu.co
CHATBOT_ISOLUCION_DOCUMENT_PATH_PREFIX=/IsolucionEsap
CHATBOT_ISOLUCION_DOCUMENT_ORIGINS=
CHATBOT_ISOLUCION_DOCUMENT_PATHS=/IsolucionEsap/BancoConocimientoIsolucionEsap/
# Sesión técnica de consulta: inyectar las credenciales web por separado de SQL.
CHATBOT_ISOLUCION_WEB_AUTH_ENABLED=true
CHATBOT_ISOLUCION_WEB_LOGIN_URL=https://isolucion.esap.edu.co/IsolucionEsap/PaginaLogin.aspx
CHATBOT_ISOLUCION_WEB_USER=consulta.isolucion
CHATBOT_ISOLUCION_WEB_PASSWORD=
