# Puerto del API Gateway
PORT=4000

# URLs de los microservicios
AUTH_SERVICE_URL=http://auth-service:3000
ACADEMIC_REGISTRATION_SERVICE_URL=http://academic-registration-service:3000
ACADEMIC_WORK_PLAN_SERVICE_URL=http://academic-work-plan-service:3000
CERTIFICATION_SERVICE_URL=http://certification-service:3000
INTERNAL_DISCIPLINARY_CONTROL_SERVICE_URL=http://internal-disciplinary-control-service:3000
INTERNAL_INSTITUTIONAL_CONTROL_SERVICE_URL=http://internal-institutional-control-service:3000
INTEROPERABILITY_SERVICE_URL=http://interoperability-service:3000
LEGAL_MANAGEMENT_SERVICE_URL=http://legal-management-service:3000
NOTIFICATIONS_SERVICE_URL=http://notifications-service:3000
TRAVEL_EXPENSES_SERVICE_URL=http://travel-expenses-service:3000

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# CORS
CORS_ORIGIN=http://localhost:3000

# JWT Configuration
# Debe coincidir con JWT_SECRET del auth-service porque el gateway valida el token antes de reenviar la solicitud.
JWT_SECRET=jwt_example_secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=jwt_example_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Environment
NODE_ENV=development