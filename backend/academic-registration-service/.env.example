# Puerto del servicio
PORT=3002

# Base de datos
DATABASE_URL=postgresql://username:password@localhost:5432/academic_registration_db

# API Gateway URL
API_GATEWAY_URL=http://localhost:3000

# Auth Service URL
AUTH_SERVICE_URL=http://localhost:3001

# Notification Service URL
NOTIFICATION_SERVICE_URL=http://localhost:3009

# Environment
NODE_ENV=development

# Oracle SINU - certificados de graduados
ORACLE_GRAD_ENABLED=false
ORACLE_GRAD_USER=
ORACLE_GRAD_PASSWORD=""
ORACLE_GRAD_CONNECT_STRING=""
ORACLE_GRAD_SCHEMA=
