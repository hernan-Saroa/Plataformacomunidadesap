# Puerto del servicio
PORT=3001

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=esap_db
DB_SCHEMA=auth

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (para recuperación de contraseña, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password
EMAIL_FROM=noreply@esap.edu.co

# Redis (si usas para sesiones o cache)
REDIS_URL=redis://localhost:6379

# API Gateway URL (para comunicación interna)
API_GATEWAY_URL=http://localhost:4000

# Otros servicios URLs
USER_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3009

# Environment
NODE_ENV=development