# Puerto del servicio
PORT=3001

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=esap_db
DB_SCHEMA=auth

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (para recuperación de contraseña, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password
EMAIL_FROM=noreply@esap.edu.co

# Redis (si usas para sesiones o cache)
REDIS_URL=redis://localhost:6379

# API Gateway URL (para comunicación interna)
API_GATEWAY_URL=http://localhost:4000

# Otros servicios URLs
USER_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3009

# Consulta de documentos al propietario RUND; activar tras publicar su API interna.
RUND_SERVICE_URL=http://localhost:3016
RUND_CARPETA_ENABLED=false
# Solo tras aplicar db/migrations/667_auth_carpeta_documento_versiones.sql.
# No habilita la integración RUND; el paso 12 sigue pendiente.
CARPETA_DOCUMENT_VERSIONING_ENABLED=false
# Mismo valor en rund-service. No usar JWT_SECRET ni variables VITE_ para esta credencial.
RUND_CARPETA_INTERNAL_TOKEN=
# Aplicar 668 en Auth y 007 en RUND antes de activar en ambos servicios.
# Credencial interna compartida. Nunca JWT_SECRET ni VITE_.
RUND_CARPETA_SYNC_ENABLED=false
RUND_CARPETA_SYNC_TOKEN=

# Environment
NODE_ENV=development
# rund-service (API interna, servicio a servicio). Mismo INTERNAL_SERVICE_TOKEN que rund-service.
# Incluye /internal/rund/v1/banco/proyeccion para listado, ficha y estadísticas RUND.
# /internal/rund/v1/personas/ficha/* y por-alias/* cubren tarjeta/autogestión y resolución histórica.
# POST /internal/rund/v1/personas/coincidencias: proyección de unicidad y nombre/fecha para RUND.
# POST /internal/rund/v1/personas/destinatario-aviso: cuenta activa del solicitante de un análisis OCR.
# POST /internal/rund/v1/personas/permisos-roles: permisos activos de los roles/códigos candidatos del servidor RUND.
# GET /internal/rund/v1/personas/sincronizacion/rol-docente y POST sincronizacion/revalidar:
# rol y cuenta vigentes para el alta mínima en RUND; misma credencial interna, sin JWT de usuario.
# También protege GET /internal/rund/v1/personas/{por-documento,resolver}/:clave.
# Para identidad no se acepta JWT_SECRET como sustituto de esta credencial.
# También protege GET /internal/rund/v1/catalogos/seccionales.
# Y GET /internal/rund/v1/catalogos/territoriales-banco (ID, nombre y código para carga/edición).
# También GET /internal/rund/v1/personas/perfil-pta/:cedula (identidad mínima para interoperabilidad RUND).
# También protege POST /internal/rund/v1/personas/escritura/validar (solo prevalidación, sin reservas ni escrituras).
INTERNAL_SERVICE_TOKEN=
