# ============================================================================
# academic-schedule-service — Programación Académica
#
# Copie este archivo a `.env` y ajuste los valores de su máquina.
# ============================================================================

# Puerto del microservicio. El gateway lo enruta como `programacion-academica`.
PORT=3013
NODE_ENV=development

# ── Base de datos ───────────────────────────────────────────────────────────
#
# El valor por defecto apunta al contenedor `superapp-db`, que docker-compose
# publica en el 55432. Funciona sin pasos extra: levante el contenedor y corra
# `npm run db:migrate`.
#
# ⚠️ POR QUÉ 55432 Y NO 5432
# Un PostgreSQL instalado como servicio de Windows se queda con el 5432 a nivel
# de sistema y TAPA el mapeo del contenedor: `docker ps` muestra la publicación,
# pero las conexiones llegan al Postgres local. El síntoma es traicionero — la
# base existe, autentica o no según el caso, y el módulo aparece VACÍO sin error
# claro. Publicar en 55432 elimina la disputa; no lo devuelva a 5432.
#
# Para apuntar a un PostgreSQL local en su lugar, cambie host y puerto y corra
# `npm run db:migrate` contra él: el runner es idempotente y crea todo.
#
DB_HOST=localhost
DB_PORT=55432
DB_NAME=esap_db
DB_USER=postgres

# El repo usa DB_PASS (es lo que inyecta docker-compose y lo que lee el PTA).
# DB_PASSWORD se acepta como alias por compatibilidad.
DB_PASS=esap_secure_password_2024

# ── Autenticación ───────────────────────────────────────────────────────────
# El servicio exige token válido (guard global, EFDS-1791). La identidad efectiva
# —roles— la reenvía el gateway por cabeceras (x-user-id, x-user-roles).
JWT_SECRET=esap-super-secret-jwt-key-2024
