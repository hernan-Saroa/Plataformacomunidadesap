# ============================================================================
# academic-schedule-service — Programación Académica
#
# Copie este archivo a `.env` y ajuste los valores de su máquina.
# ============================================================================

# Puerto del microservicio. El gateway lo enruta como `programacion-academica`.
PORT=3013
NODE_ENV=development

# ── Base de datos ───────────────────────────────────────────────────────────
#
# ⚠️ CONFLICTO DE PUERTO EN WINDOWS — leer antes de cambiar DB_PORT
#
# Si tiene PostgreSQL instalado como servicio de Windows, ese proceso se queda
# con el 5432 y TAPA el puerto publicado por el contenedor `superapp-db`. Las
# conexiones a localhost:5432 llegan al Postgres LOCAL, no al contenedor, aunque
# `docker port` muestre el mapeo. El síntoma es "la autentificación password
# falló" o una base que existe pero aparece vacía.
#
# Hay dos formas de trabajar, y hay que elegir UNA:
#
#   A) LOCAL, SIN DOCKER (recomendado para desarrollo)
#      Use su PostgreSQL local en el 5432 —los valores de abajo— y prepare la
#      base con:  npm run db:setup
#      No necesita levantar ningún contenedor.
#
#   B) CONTRA EL CONTENEDOR
#      Si el 5432 local está ocupado, publique el contenedor en otro puerto y
#      apunte DB_PORT ahí. Por ejemplo:
#        docker run -d --name pgfwd --network plataformacomunidadesap_superapp-net \
#          -p 55432:5432 alpine/socat tcp-listen:5432,fork,reuseaddr tcp-connect:superapp-db:5432
#      y luego DB_PORT=55432
#      (`docker rm -f pgfwd` para quitarlo; no altera el contenedor ni su Postgres local.)
#
DB_HOST=localhost
DB_PORT=5432
DB_NAME=esap_db
DB_USER=postgres

# El repo usa DB_PASS (es lo que inyecta docker-compose y lo que lee el PTA).
# DB_PASSWORD se acepta como alias por compatibilidad.
DB_PASS=postgres

# ── Autenticación ───────────────────────────────────────────────────────────
# La identidad la reenvía el gateway por cabeceras (x-user-id, x-user-roles),
# no por `req.user`. Este secreto solo se usa si el servicio se expone directo.
JWT_SECRET=super-secret-jwt-key
