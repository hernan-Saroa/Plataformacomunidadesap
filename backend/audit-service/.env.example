# ============================================
# AUDIT SERVICE - Variables de Entorno
# ============================================
# Copia este archivo como .env y configura los valores segun tu entorno

# Entorno de ejecucion
NODE_ENV=development

# Puerto del servicio
PORT=3011

# ============================================
# Base de Datos PostgreSQL
# ============================================
# Host de la base de datos (usar 'db' para Docker, 'localhost' para desarrollo local)
DB_HOST=localhost

# Puerto de PostgreSQL
DB_PORT=5432

# Usuario de la base de datos
DB_USER=postgres

# Contrasena de la base de datos
DB_PASSWORD=postgres

# Nombre de la base de datos
DB_NAME=esap_db

# SSL de la base de datos (true/false)
DB_SSL=false
