# ============================================
# AUDIT SERVICE - Variables de Entorno
# ============================================
# Copia este archivo como .env y configura los valores segun tu entorno

# Entorno de ejecucion
NODE_ENV=development

# Puerto del servicio
PORT=3011

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=esap_db
DB_SCHEMA=audit

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=7d