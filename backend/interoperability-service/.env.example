# Puerto del servicio
PORT=3007

# Base de datos
DATABASE_URL=postgresql://username:password@localhost:5432/interoperability_db

# API Gateway URL
API_GATEWAY_URL=http://localhost:3000

# Auth Service URL
AUTH_SERVICE_URL=http://localhost:3001

# External API Keys (para integración con otros sistemas)
EXTERNAL_API_KEY=your-external-api-key
EXTERNAL_API_BASE_URL=https://api.external-service.com

# Notification Service URL
NOTIFICATION_SERVICE_URL=http://localhost:3009

# Environment
NODE_ENV=development