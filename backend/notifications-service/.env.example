# Puerto del servicio
PORT=3009

# Base de datos
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=esap_db
DB_SCHEMA=notifications

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=7d

TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false

# API Gateway URL
API_GATEWAY_URL=http://localhost:4000

# Auth Service URL
AUTH_SERVICE_URL=http://localhost:3001

# Email Configuration (SMTP o Microsoft Graph)
EMAIL_PROVIDER=smtp
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
NOTIFICATIONS_EMAIL_ACCOUNT=
# MAIL_TEST_INBOX recibe los avisos de prueba en el capturador SMTP.

# Push Notifications (opcional)
# FCM_SERVER_KEY=your-fcm-server-key

# Environment
NODE_ENV=development

# Dominios que pueden recibir el buzón de desvío de un módulo (separados por comas)
NOTIFICACIONES_DOMINIOS_DESVIO=esap.edu.co

# EFDS-2238. El capturador es opcional; dejar MAIL_TEST_INBOX vacío para entrega normal.
MAIL_ENVIRONMENT=local
JURIDICA_EMAIL=
MAIL_TEST_INBOX=
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
