# Puerto del servicio
PORT=3002

# Base de datos
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=esap_db
DB_SCHEMA=legal_management

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=7d

# API Gateway URL
API_GATEWAY_URL=http://localhost:4000

# Auth Service URL
AUTH_SERVICE_URL=http://localhost:3001

# Notification Service URL
NOTIFICATION_SERVICE_URL=http://localhost:3009

# Document Storage
DOCUMENT_STORAGE_PATH=./uploads/legal-documents
# Para cloud storage
# AZURE_STORAGE_ACCOUNT=your-account
# AZURE_STORAGE_KEY=your-key
# AZURE_CONTAINER=legal-documents

# Environment
NODE_ENV=development

# Microsoft Graph API (Email Integration)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
LEGAL_EMAIL_ACCOUNT=desarrollo.ccd@esap.edu.co

# Centro de Comunicaciones — DOS buzones (cuentas de correo):
#   JUDICIAL → tab Judiciales/Oficios   |   CORREOS → tab Correos
# Los tabs generales (Respondidos/Urgentes/Enviados/Archivados) muestran ambos
# con un filtro interno por buzón. Si CORREOS queda vacío, solo se usa el judicial.
LEGAL_EMAIL_ACCOUNT_JUDICIAL=desarrollo.ccd@esap.edu.co
LEGAL_EMAIL_ACCOUNT_CORREOS=