# Puerto del servicio
PORT=3003

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=esap_db
DB_SCHEMA=academic_work_plan
TYPEORM_SYNC=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=7d

# API Gateway URL
API_GATEWAY_URL=http://localhost:4000

# Auth Service URL
AUTH_SERVICE_URL=http://localhost:3001

# Notification Service URL
NOTIFICATION_SERVICE_URL=http://localhost:3009

# URL pública del frontend (para links en correos de autogestión RUND)
PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development

# Solo desarrollo/pruebas: habilitar explícitamente el OTP de prueba en la respuesta.
# Nunca se devuelve en producción.
RUND_ENABLE_DEV_OTP=false

# rund-service (API interna, servicio a servicio). Mismo INTERNAL_SERVICE_TOKEN que rund-service.
RUND_SERVICE_URL=http://localhost:3016
INTERNAL_SERVICE_TOKEN=
# También protege GET /internal/rund/v1/catalogos/territoriales (sin filtro de activos/período).
# Y GET /internal/rund/v1/catalogos/periodo-activo (cero o un período en curso).
# Y GET /internal/rund/v1/personas/:personaId/nombre-historico (partes originales de Persona).
# POST /internal/rund/v1/personas/identidades-historicas: lote de identidad histórica para Macro Docente RUND.
# POST /internal/rund/v1/catalogos/programas-historicos: respaldo del historial, excluye deleted_at y conserva inactivos.
# POST /internal/rund/v1/planes/historial-firme: planes firmes por docente y/o período para Macro Docente RUND.
# Proyección de perfiles RUND -> PTA; requiere habilitación explícita.
RUND_SYNC_ENABLED=false
RUND_SYNC_INTERVAL_MINUTES=10
