# Puerto del servicio
PORT=3003

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=esap_db
DB_SCHEMA=academic_work_plan
TYPEORM_SYNC=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=7d

# API Gateway URL
API_GATEWAY_URL=http://localhost:4000

# Auth Service URL
AUTH_SERVICE_URL=http://localhost:3001

# Notification Service URL
NOTIFICATION_SERVICE_URL=http://localhost:3009

# URL pública del frontend (para links en correos de autogestión RUND)
PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development

# Solo desarrollo/pruebas: habilitar explícitamente el OTP de prueba en la respuesta.
# Nunca se devuelve en producción.
RUND_ENABLE_DEV_OTP=false

# Repositorio documental RUND (F011/F012). Configurar en el backend únicamente.
RUND_DOCUMENTAL_ENABLED=false
# Configuración provisional local. En servidores, validar persistencia antes de habilitar.
OPENKM_BASE_URL=
OPENKM_USERNAME=
OPENKM_PASSWORD=
OPENKM_TIMEOUT_MS=15000
RUND_DOCUMENT_MAX_SIZE_BYTES=10485760
RUND_DOCUMENT_ALLOW_LOCAL=true
# AUTO conserva la selección anterior por URL; LOCAL es provisional y requiere ALLOW_LOCAL=true.
# OPENKM exige configuración completa y nunca vuelve al disco cuando falla.
RUND_DOCUMENT_PROVIDER=LOCAL
# Vacío conserva ./uploads. Al cambiarlo se deben copiar antes TODOS los archivos existentes.
RUND_DOCUMENT_LOCAL_ROOT=
# Archivos JSON aprobados, montados solo lectura. Vacío registra pendientes y conserva documentos.
RUND_TRD_POLICY_FILE=
RUND_PRIVACY_POLICY_FILE=
