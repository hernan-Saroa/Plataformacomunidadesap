# Generar con: node scripts/rund-ai/manage.cjs dev init
# No contiene claves. No agregar DB_*, JWT_*, CHATBOT_* ni RUND_DOCUMENTAL_*.
RUND_OCR_ENABLED=true
RUND_OCR_PROVIDER=RUND
RUND_OCR_URL=http://rund-ocr:8000
RUND_OLLAMA_URL=http://rund-ollama:11434
RUND_OLLAMA_MODEL=gemma4:e4b
# managed: motores propios por ambiente; external: reutilizar una red existente.
RUND_AI_MODE=managed
RUND_AI_NETWORK=esap-rund-ai-dev
RUND_AI_OCR_PORT=8091
RUND_AI_OLLAMA_PORT=11435
