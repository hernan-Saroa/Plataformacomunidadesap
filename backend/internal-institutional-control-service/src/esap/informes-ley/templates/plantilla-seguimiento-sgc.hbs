<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{{nombreInforme}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, sans-serif; font-size: 11pt; padding: 20mm 15mm; }
    .header { background: linear-gradient(135deg, #003DA5 0%, #0052CC 100%); color: white; padding: 20px 30px; margin-bottom: 30px; border-radius: 5px; }
    .titulo-informe { text-align: center; margin: 30px 0; padding: 20px; background: #f8f9fa; border-left: 5px solid #003DA5; }
    .seccion { margin-bottom: 30px; }
    .seccion h3 { font-size: 13pt; color: #003DA5; border-bottom: 2px solid #003DA5; padding-bottom: 8px; margin-bottom: 15px; }
    table { width: 100%; border-collapse: collapse; margin: 15px 0; }
    table th, table td { padding: 10px; text-align: left; border: 1px solid #ddd; }
    table th { background: #003DA5; color: white; }
    ul { list-style: none; padding: 0; }
    ul li { padding: 10px; margin-bottom: 10px; background: #f8f9fa; border-left: 4px solid #003DA5; border-radius: 3px; }
  </style>
</head>
<body>
  <div class="header"><h1>ESCUELA SUPERIOR DE ADMINISTRACIÓN PÚBLICA - ESAP</h1><p>Oficina de Control Interno de Gestión</p></div>
  <div class="titulo-informe"><h2>{{nombreInforme}}</h2><p>Periodo: {{periodo}}{{#if trimestre}} - Trimestre: {{trimestre}}{{/if}}</p></div>
  <div class="seccion">
    <h3>1. Indicadores</h3>
    {{#if indicadores}}{{#if indicadores.length}}<table><thead><tr><th>Indicador</th><th>Valor</th><th>Unidad</th></tr></thead><tbody>{{#each indicadores}}<tr><td>{{this.nombre}}</td><td>{{this.valor}}</td><td>{{#if this.unidad}}{{this.unidad}}{{else}}-{{/if}}</td></tr>{{/each}}</tbody></table>{{else}}<p style="color: #999; font-style: italic;">No hay indicadores disponibles.</p>{{/if}}{{else}}<p style="color: #999; font-style: italic;">No hay indicadores disponibles.</p>{{/if}}
  </div>
  <div class="seccion">
    <h3>2. No Conformidades</h3>
    {{#if noConformidades}}{{#if noConformidades.length}}<ul>{{#each noConformidades}}<li><strong>{{this.descripcion}}</strong> - Estado: {{this.estado}}</li>{{/each}}</ul>{{else}}<p style="color: #999; font-style: italic;">No hay no conformidades registradas.</p>{{/if}}{{else}}<p style="color: #999; font-style: italic;">No hay no conformidades registradas.</p>{{/if}}
  </div>
  <div class="seccion">
    <h3>3. Acciones Correctivas</h3>
    {{#if accionesCorrectivas}}{{#if accionesCorrectivas.length}}<ul>{{#each accionesCorrectivas}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p style="color: #999; font-style: italic;">No hay acciones correctivas registradas.</p>{{/if}}{{else}}<p style="color: #999; font-style: italic;">No hay acciones correctivas registradas.</p>{{/if}}
  </div>
  <div class="seccion">
    <h3>4. Resultados</h3>
    {{#if resultados}}<p><strong>Resumen:</strong> {{resultados.resumen}}</p><p><strong>Cumplimiento:</strong> {{resultados.cumplimiento}}</p>{{else}}<p style="color: #999; font-style: italic;">No hay resultados disponibles.</p>{{/if}}
  </div>
  {{#if baseNormativa}}<div style="margin-top: 30px; padding: 15px; background: #fff3cd; border-left: 4px solid #ffc107;"><strong>Base Normativa:</strong> {{baseNormativa}}</div>{{/if}}
  <div style="margin-top: 50px; padding-top: 20px; border-top: 2px solid #ddd; text-align: center; font-size: 9pt;"><p>Documento generado el {{fechaGeneracion}} por {{responsable}}</p></div>
</body>
</html>
