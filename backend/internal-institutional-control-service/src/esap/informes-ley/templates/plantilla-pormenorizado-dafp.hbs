<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{nombreInforme}}</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Arial', sans-serif;
      font-size: 11pt;
      line-height: 1.6;
      color: #333;
      padding: 20mm 15mm;
    }
    
    .header {
      background: linear-gradient(135deg, #003DA5 0%, #0052CC 100%);
      color: white;
      padding: 20px 30px;
      margin-bottom: 30px;
      border-radius: 5px;
    }
    
    .header h1 {
      font-size: 14pt;
      font-weight: bold;
      margin-bottom: 5px;
    }
    
    .header p {
      font-size: 10pt;
      opacity: 0.95;
    }
    
    .titulo-informe {
      text-align: center;
      margin: 30px 0;
      padding: 20px;
      background: #f8f9fa;
      border-left: 5px solid #003DA5;
    }
    
    .titulo-informe h2 {
      font-size: 16pt;
      color: #003DA5;
      margin-bottom: 10px;
    }
    
    .info-documento {
      display: flex;
      justify-content: space-between;
      margin-bottom: 30px;
      padding: 15px;
      background: #f0f4f8;
      border-radius: 5px;
    }
    
    .info-item {
      flex: 1;
    }
    
    .info-item strong {
      color: #003DA5;
      display: block;
      margin-bottom: 5px;
    }
    
    .seccion {
      margin-bottom: 30px;
    }
    
    .seccion h3 {
      font-size: 13pt;
      color: #003DA5;
      border-bottom: 2px solid #003DA5;
      padding-bottom: 8px;
      margin-bottom: 15px;
    }
    
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 15px 0;
    }
    
    table th,
    table td {
      padding: 10px;
      text-align: left;
      border: 1px solid #ddd;
    }
    
    table th {
      background: #003DA5;
      color: white;
      font-weight: bold;
    }
    
    table tr:nth-child(even) {
      background: #f8f9fa;
    }
    
    .firmas {
      margin-top: 50px;
      display: flex;
      justify-content: space-around;
      padding-top: 30px;
      border-top: 2px solid #ddd;
    }
    
    .firma {
      text-align: center;
      width: 200px;
    }
    
    .firma .linea {
      border-top: 1px solid #333;
      margin: 60px 0 10px 0;
      padding-top: 5px;
    }
    
    .firma p {
      font-size: 10pt;
      margin: 5px 0;
    }
    
    .firma .nombre {
      font-weight: bold;
    }
    
    .firma .cargo {
      color: #666;
      font-size: 9pt;
    }
    
    .footer {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid #ddd;
      text-align: center;
      font-size: 9pt;
      color: #666;
    }
  </style>
</head>
<body>
  <!-- Encabezado Institucional -->
  <div class="header">
    <h1>ESCUELA SUPERIOR DE ADMINISTRACIÓN PÚBLICA - ESAP</h1>
    <p>Oficina de Control Interno de Gestión</p>
  </div>

  <!-- Título del Informe -->
  <div class="titulo-informe">
    <h2>{{nombreInforme}}</h2>
    <p style="color: #666; font-size: 10pt;">{{baseNormativa}}</p>
  </div>

  <!-- Información del Documento -->
  <div class="info-documento">
    <div class="info-item">
      <strong>Periodo:</strong>
      <span>{{periodo}}</span>
    </div>
    <div class="info-item">
      <strong>Fecha de Generación:</strong>
      <span>{{fechaGeneracion}}</span>
    </div>
    <div class="info-item">
      <strong>Responsable:</strong>
      <span>{{responsable}}</span>
    </div>
  </div>

  <!-- Sección 1: Datos Automáticos -->
  {{#if datosAutomaticos}}
  <div class="seccion">
    <h3>1. DATOS AUTOMÁTICOS DEL SISTEMA</h3>
    <table>
      <thead>
        <tr>
          <th>Indicador</th>
          <th>Valor</th>
        </tr>
      </thead>
      <tbody>
        {{#each datosAutomaticos}}
        <tr>
          <td>{{this.nombre}}</td>
          <td>{{this.valor}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  <!-- Sección 2: Análisis -->
  <div class="seccion">
    <h3>2. ANÁLISIS Y EVALUACIÓN</h3>
    {{#if analisis}}
      <p>{{analisis}}</p>
    {{else}}
      <p style="color: #999; font-style: italic;">
        [Este espacio está disponible para el análisis y evaluación del estado del control interno 
        durante el periodo reportado. El análisis debe incluir conclusiones sobre el cumplimiento 
        de los objetivos del sistema de control interno, identificación de fortalezas y debilidades, 
        y recomendaciones para el mejoramiento continuo.]
      </p>
    {{/if}}
  </div>

  <!-- Sección 3: Conclusiones -->
  <div class="seccion">
    <h3>3. CONCLUSIONES</h3>
    {{#if conclusiones}}
      <p>{{conclusiones}}</p>
    {{else}}
      <p style="color: #999; font-style: italic;">
        [Espacio para las conclusiones del informe]
      </p>
    {{/if}}
  </div>

  <!-- Firmas -->
  <div class="firmas">
    <div class="firma">
      <div class="linea"></div>
      <p class="nombre">{{responsable}}</p>
      <p class="cargo">Profesional Responsable</p>
    </div>
    <div class="firma">
      <div class="linea"></div>
      <p class="nombre">Jefe de Control Interno</p>
      <p class="cargo">Oficina de Control Interno de Gestión</p>
    </div>
  </div>

  <!-- Pie de Página -->
  <div class="footer">
    <p>Documento generado automáticamente por el Sistema de Gestión de Control Interno - ESAP</p>
    <p>{{fechaGeneracion}}</p>
  </div>
</body>
</html>
