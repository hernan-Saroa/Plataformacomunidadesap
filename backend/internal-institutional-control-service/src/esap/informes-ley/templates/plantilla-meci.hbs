<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{nombreInforme}}</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Arial', sans-serif;
      font-size: 11pt;
      line-height: 1.6;
      color: #333;
      padding: 20mm 15mm;
    }
    
    .header {
      background: linear-gradient(135deg, #003DA5 0%, #0052CC 100%);
      color: white;
      padding: 20px 30px;
      margin-bottom: 30px;
      border-radius: 5px;
    }
    
    .header h1 {
      font-size: 14pt;
      font-weight: bold;
      margin-bottom: 5px;
    }
    
    .header p {
      font-size: 10pt;
      opacity: 0.95;
    }
    
    .titulo-informe {
      text-align: center;
      margin: 30px 0;
      padding: 20px;
      background: #f8f9fa;
      border-left: 5px solid #003DA5;
    }
    
    .titulo-informe h2 {
      font-size: 16pt;
      color: #003DA5;
      margin-bottom: 10px;
    }
    
    .info-metadata {
      display: flex;
      justify-content: space-between;
      margin-bottom: 30px;
      padding: 15px;
      background: #f8f9fa;
      border-radius: 5px;
      font-size: 10pt;
    }
    
    .info-metadata div {
      flex: 1;
    }
    
    .info-metadata strong {
      color: #003DA5;
    }
    
    .seccion {
      margin-bottom: 30px;
      page-break-inside: avoid;
    }
    
    .seccion h3 {
      font-size: 13pt;
      color: #003DA5;
      margin-bottom: 15px;
      padding-bottom: 8px;
      border-bottom: 2px solid #003DA5;
    }
    
    .evaluacion-meci {
      background: #e8f4f8;
      padding: 20px;
      border-radius: 5px;
      margin-bottom: 25px;
    }
    
    .componentes-lista {
      list-style: none;
      padding: 0;
    }
    
    .componentes-lista li {
      padding: 15px;
      margin-bottom: 10px;
      background: #f8f9fa;
      border-left: 4px solid #003DA5;
      border-radius: 3px;
    }
    
    .componente-nombre {
      font-weight: bold;
      color: #003DA5;
      margin-bottom: 5px;
    }
    
    .componente-estado {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 3px;
      font-size: 9pt;
      margin-left: 10px;
    }
    
    .estado-cumple {
      background: #d4edda;
      color: #155724;
    }
    
    .estado-no-cumple {
      background: #f8d7da;
      color: #721c24;
    }
    
    .estado-en-proceso {
      background: #fff3cd;
      color: #856404;
    }
    
    .resultados {
      background: #f0f8f0;
      padding: 20px;
      border-radius: 5px;
      margin-bottom: 25px;
    }
    
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 15px 0;
    }
    
    table th,
    table td {
      padding: 10px;
      text-align: left;
      border: 1px solid #ddd;
    }
    
    table th {
      background: #003DA5;
      color: white;
      font-weight: bold;
    }
    
    table tr:nth-child(even) {
      background: #f8f9fa;
    }
    
    .recomendaciones-lista {
      list-style: none;
      padding: 0;
    }
    
    .recomendaciones-lista li {
      padding: 10px;
      margin-bottom: 10px;
      background: #fff3cd;
      border-left: 4px solid #ffc107;
      border-radius: 3px;
    }
    
    .base-normativa {
      margin-top: 30px;
      padding: 15px;
      background: #fff3cd;
      border-left: 4px solid #ffc107;
      border-radius: 3px;
      font-size: 10pt;
    }
    
    .base-normativa strong {
      color: #856404;
    }
    
    .footer {
      margin-top: 50px;
      padding-top: 20px;
      border-top: 2px solid #ddd;
      text-align: center;
      font-size: 9pt;
      color: #666;
    }
    
    @media print {
      body {
        padding: 15mm 10mm;
      }
      .seccion {
        page-break-inside: avoid;
      }
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>ESCUELA SUPERIOR DE ADMINISTRACIÓN PÚBLICA - ESAP</h1>
    <p>Oficina de Control Interno de Gestión</p>
  </div>

  <div class="titulo-informe">
    <h2>{{nombreInforme}}</h2>
    <p>Periodo: {{periodo}}</p>
  </div>

  <div class="info-metadata">
    <div>
      <strong>Fecha de Generación:</strong> {{fechaGeneracion}}
    </div>
    <div>
      <strong>Responsable:</strong> {{responsable}}
    </div>
  </div>

  {{#if evaluacionMECI}}
  <div class="seccion evaluacion-meci">
    <h3>1. Evaluación del MECI</h3>
    {{#if evaluacionMECI.resumen}}
    <p><strong>Resumen de la Evaluación:</strong></p>
    <p>{{evaluacionMECI.resumen}}</p>
    {{/if}}
    {{#if evaluacionMECI.nivelCumplimiento}}
    <p><strong>Nivel de Cumplimiento:</strong> {{evaluacionMECI.nivelCumplimiento}}%</p>
    {{/if}}
    {{#if evaluacionMECI.fortalezas}}
    <p><strong>Fortalezas Identificadas:</strong></p>
    <ul>
      {{#each evaluacionMECI.fortalezas}}
      <li>{{this}}</li>
      {{/each}}
    </ul>
    {{/if}}
    {{#if evaluacionMECI.debilidades}}
    <p><strong>Debilidades Identificadas:</strong></p>
    <ul>
      {{#each evaluacionMECI.debilidades}}
      <li>{{this}}</li>
      {{/each}}
    </ul>
    {{/if}}
  </div>
  {{else}}
  <div class="seccion evaluacion-meci">
    <h3>1. Evaluación del MECI</h3>
    <p style="color: #999; font-style: italic; padding: 20px; text-align: center;">
      No hay datos de evaluación MECI disponibles para este periodo.
    </p>
  </div>
  {{/if}}

  {{#if componentes}}
  <div class="seccion">
    <h3>2. Componentes del MECI Evaluados</h3>
    {{#if componentes.length}}
    <ul class="componentes-lista">
      {{#each componentes}}
      <li>
        <div class="componente-nombre">
          {{#if this.nombre}}{{this.nombre}}{{else}}{{this}}{{/if}}
          {{#if this.estado}}
          <span class="componente-estado estado-{{this.estado}}">{{this.estado}}</span>
          {{/if}}
        </div>
        {{#if this.descripcion}}
        <p style="margin-top: 5px; font-size: 10pt; color: #666;">{{this.descripcion}}</p>
        {{/if}}
        {{#if this.cumplimiento}}
        <p style="margin-top: 5px; font-size: 9pt;"><strong>Cumplimiento:</strong> {{this.cumplimiento}}%</p>
        {{/if}}
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p style="color: #999; font-style: italic; padding: 15px;">
      No hay componentes evaluados para este periodo.
    </p>
    {{/if}}
  </div>
  {{else}}
  <div class="seccion">
    <h3>2. Componentes del MECI Evaluados</h3>
    <p style="color: #999; font-style: italic; padding: 15px;">
      No hay componentes evaluados para este periodo.
    </p>
  </div>
  {{/if}}

  {{#if resultados}}
  <div class="seccion resultados">
    <h3>3. Resultados de la Evaluación</h3>
    {{#if resultados.resumen}}
    <p><strong>Resumen:</strong> {{resultados.resumen}}</p>
    {{/if}}
    {{#if resultados.indicadores}}
    <table>
      <thead>
        <tr>
          <th>Indicador</th>
          <th>Valor</th>
          <th>Meta</th>
          <th>Estado</th>
        </tr>
      </thead>
      <tbody>
        {{#each resultados.indicadores}}
        <tr>
          <td>{{this.nombre}}</td>
          <td>{{this.valor}} {{#if this.unidad}}{{this.unidad}}{{/if}}</td>
          <td>{{#if this.meta}}{{this.meta}}{{else}}-{{/if}}</td>
          <td>
            {{#if this.cumplimiento}}
            <span class="componente-estado estado-{{this.cumplimiento}}">{{this.cumplimiento}}</span>
            {{else}}-{{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}
    {{#if resultados.conclusiones}}
    <p style="margin-top: 15px;"><strong>Conclusiones:</strong></p>
    <p>{{resultados.conclusiones}}</p>
    {{/if}}
  </div>
  {{else}}
  <div class="seccion resultados">
    <h3>3. Resultados de la Evaluación</h3>
    <p style="color: #999; font-style: italic; padding: 15px;">
      No hay resultados de evaluación disponibles para este periodo.
    </p>
  </div>
  {{/if}}

  {{#if recomendaciones}}
  <div class="seccion">
    <h3>4. Recomendaciones</h3>
    {{#if recomendaciones.length}}
    <ul class="recomendaciones-lista">
      {{#each recomendaciones}}
      <li>{{#if this.texto}}{{this.texto}}{{else}}{{this}}{{/if}}</li>
      {{/each}}
    </ul>
    {{else}}
    <p style="color: #999; font-style: italic; padding: 15px;">
      No hay recomendaciones registradas para este periodo.
    </p>
    {{/if}}
  </div>
  {{else}}
  <div class="seccion">
    <h3>4. Recomendaciones</h3>
    <p style="color: #999; font-style: italic; padding: 15px;">
      No hay recomendaciones registradas para este periodo.
    </p>
  </div>
  {{/if}}

  {{#if baseNormativa}}
  <div class="base-normativa">
    <strong>Base Normativa:</strong> {{baseNormativa}}
  </div>
  {{/if}}

  <div class="footer">
    <p>Documento generado el {{fechaGeneracion}} por {{responsable}}</p>
    <p>Oficina de Control Interno de Gestión - ESAP</p>
  </div>
</body>
</html>
