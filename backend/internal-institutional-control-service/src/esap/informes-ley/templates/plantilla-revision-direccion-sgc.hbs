<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{{nombreInforme}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, sans-serif; font-size: 11pt; padding: 20mm 15mm; }
    .header { background: linear-gradient(135deg, #003DA5 0%, #0052CC 100%); color: white; padding: 20px 30px; margin-bottom: 30px; border-radius: 5px; }
    .header h1 { font-size: 14pt; font-weight: bold; margin-bottom: 5px; }
    .titulo-informe { text-align: center; margin: 30px 0; padding: 20px; background: #f8f9fa; border-left: 5px solid #003DA5; }
    .titulo-informe h2 { font-size: 16pt; color: #003DA5; }
    .seccion { margin-bottom: 30px; }
    .seccion h3 { font-size: 13pt; color: #003DA5; border-bottom: 2px solid #003DA5; padding-bottom: 8px; margin-bottom: 15px; }
    ul { list-style: none; padding: 0; }
    ul li { padding: 10px; margin-bottom: 10px; background: #f8f9fa; border-left: 4px solid #003DA5; border-radius: 3px; }
  </style>
</head>
<body>
  <div class="header">
    <h1>ESCUELA SUPERIOR DE ADMINISTRACIÓN PÚBLICA - ESAP</h1>
    <p>Oficina de Control Interno de Gestión</p>
  </div>
  <div class="titulo-informe">
    <h2>{{nombreInforme}}</h2>
    <p>Periodo: {{periodo}}</p>
  </div>
  <div class="seccion">
    <h3>1. Entradas</h3>
    {{#if entradas}}{{#if entradas.length}}<ul>{{#each entradas}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p style="color: #999; font-style: italic;">No hay entradas registradas.</p>{{/if}}{{else}}<p style="color: #999; font-style: italic;">No hay entradas registradas.</p>{{/if}}
  </div>
  <div class="seccion">
    <h3>2. Salidas</h3>
    {{#if salidas}}{{#if salidas.length}}<ul>{{#each salidas}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p style="color: #999; font-style: italic;">No hay salidas registradas.</p>{{/if}}{{else}}<p style="color: #999; font-style: italic;">No hay salidas registradas.</p>{{/if}}
  </div>
  <div class="seccion">
    <h3>3. Acciones</h3>
    {{#if acciones}}{{#if acciones.length}}<ul>{{#each acciones}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p style="color: #999; font-style: italic;">No hay acciones registradas.</p>{{/if}}{{else}}<p style="color: #999; font-style: italic;">No hay acciones registradas.</p>{{/if}}
  </div>
  <div class="seccion">
    <h3>4. Decisiones</h3>
    {{#if decisiones}}{{#if decisiones.length}}<ul>{{#each decisiones}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p style="color: #999; font-style: italic;">No hay decisiones registradas.</p>{{/if}}{{else}}<p style="color: #999; font-style: italic;">No hay decisiones registradas.</p>{{/if}}
  </div>
  {{#if baseNormativa}}<div style="margin-top: 30px; padding: 15px; background: #fff3cd; border-left: 4px solid #ffc107; border-radius: 3px;"><strong>Base Normativa:</strong> {{baseNormativa}}</div>{{/if}}
  <div style="margin-top: 50px; padding-top: 20px; border-top: 2px solid #ddd; text-align: center; font-size: 9pt; color: #666;">
    <p>Documento generado el {{fechaGeneracion}} por {{responsable}}</p>
  </div>
</body>
</html>
