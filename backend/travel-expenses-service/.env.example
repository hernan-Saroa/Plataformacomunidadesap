# Puerto del servicio
PORT=3010

# Base de datos (el servicio lee DB_*; también acepta los nombres DATABASE_*).
# Sin DB_NAME no arranca: Postgres caería en la base "postgres", sin el esquema travel_expenses.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=esap_db
DB_SCHEMA=travel_expenses

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=7d

# API Gateway URL
API_GATEWAY_URL=http://localhost:4000

# Auth Service URL
AUTH_SERVICE_URL=http://localhost:3001

# Notification Service URL
NOTIFICATION_SERVICE_URL=http://localhost:3009

# Integración Base de Datos KLIC (Microsoft SQL Server)
# Habilita o deshabilita la conexión a Klic para permitir desarrollo local sin VPN
KLIC_DB_ENABLED=false
KLIC_DB_HOST=172.16.202.145
KLIC_DB_PORT=1433
KLIC_DB_NAME=Klic
KLIC_DB_USER=usrIntegracionKlic
KLIC_DB_PASS=
KLIC_DB_ENCRYPT=true
KLIC_DB_TRUST_SERVER_CERTIFICATE=true

# Financial Integration (opcional)
# FINANCIAL_API_URL=https://api.financial-system.com
# FINANCIAL_API_KEY=your-financial-api-key

# Receipt Storage
RECEIPT_STORAGE_PATH=./uploads/receipts

# File Storage (documentos de soporte)
# Ruta donde se guardan los archivos subidos (CDP, RUT, certificados, etc.).
# Puede apuntar a un disco/volumen dedicado/externo en despliegue; en Docker se
# monta como volumen (./backend/travel-expenses-service/uploads:/app/uploads).
TRAVEL_EXPENSES_STORAGE_PATH=./uploads

# Environment
NODE_ENV=development