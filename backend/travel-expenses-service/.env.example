# Puerto del servicio
PORT=3010

# Base de datos
DATABASE_URL=postgresql://username:password@localhost:5432/travel_expenses_db

# API Gateway URL
API_GATEWAY_URL=http://localhost:3000

# Auth Service URL
AUTH_SERVICE_URL=http://localhost:3001

# Notification Service URL
NOTIFICATION_SERVICE_URL=http://localhost:3009

# Financial Integration (opcional)
# FINANCIAL_API_URL=https://api.financial-system.com
# FINANCIAL_API_KEY=your-financial-api-key

# Receipt Storage
RECEIPT_STORAGE_PATH=./uploads/receipts

# Environment
NODE_ENV=development