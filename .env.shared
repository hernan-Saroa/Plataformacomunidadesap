# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                    VARIABLES COMPARTIDAS - ESAP                            ║
# ║                                                                            ║
# ║  Este archivo es la FUENTE DE VERDAD para todas las variables que deben    ║
# ║  ser idénticas entre todos los microservicios del backend.                 ║
# ║                                                                            ║
# ║  ⚠️  NUNCA definas JWT_SECRET directamente en los .env de cada servicio.    ║
# ║  Si lo haces, será sobreescrito por este archivo al arrancar.             ║
# ║                                                                            ║
# ║  Este archivo se lee automáticamente por:                                  ║
# ║    - npm run dev:backend  (desarrollo local)                               ║
# ║    - docker-compose.dev.yml (contenedores de desarrollo)                   ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─── JWT (autenticación) ──────────────────────────────────────────────────────
# DEBE ser idéntico en auth-service, api-gateway, y cualquier servicio que
# valide tokens JWT. Si estos valores difieren, los usuarios recibirán
# errores 401 "Unauthorized" en toda la plataforma.
JWT_SECRET=esap_jwt_secret_change_in_production
JWT_REFRESH_SECRET=esap_jwt_refresh_secret_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ─── Base de datos compartida ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=esap_db
