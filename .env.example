# =====================================================
# Variables de Entorno para DEV (Desarrollo del equipo)
# Servidor: http://4.156.71.181
# =====================================================

# ============ DATABASE ============
DB_PASSWORD=esap_secure_password_2025

# ============ JWT SECRETS ============
# IMPORTANTE: Cambiar estos valores en producción real
JWT_SECRET=esap_jwt_secret_change_in_production_2024
JWT_REFRESH_SECRET=esap_refresh_secret_change_in_production_2024

# ============ SERVER CONFIG ============
SERVER_IP=4.156.71.181
FRONTEND_URL=http://4.156.71.181
API_URL=http://4.156.71.181:3000

# ============ STORAGE CONTROL DISCIPLINARIO ============
# DISCIPLINARY_STORAGE_HOST_PATH: ruta real en el servidor host donde quedan los archivos.
# En Windows con disco dedicado puede ser: G:/control-disciplinario
# DISCIPLINARY_STORAGE_PATH: ruta interna dentro del contenedor Docker usada por NestJS.
DISCIPLINARY_STORAGE_HOST_PATH=./backend/internal-disciplinary-control-service/uploads
DISCIPLINARY_STORAGE_PATH=/app/uploads

# ============ VITE (Frontend) ============
# IMPORTANTE: Las variables para Vite DEBEN tener prefijo VITE_
VITE_API_URL=http://4.156.71.181:3000
# Valores: "gateway" enruta todo por API Gateway; "direct" llama a cada microservicio por su puerto.
VITE_API_MODE=gateway

# Puerto publicado por el gateway MFE. En PROD con Nginx SSL en el host,
# deploy.prod.sh usa 127.0.0.1:8080 por defecto para dejar libres 80/443.
# FRONTEND_GATEWAY_BIND=127.0.0.1
# FRONTEND_GATEWAY_PORT=8080

# ============ EMAIL (notifications-service) ============
EMAIL_PROVIDER=microsoft_graph
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
NOTIFICATIONS_EMAIL_ACCOUNT=notificaciones@esap.edu.co
LEGAL_EMAIL_ACCOUNT=desarrollo.ccd@esap.edu.co
LEGAL_EMAIL_ACCOUNT_JUDICIAL=desarrollo.ccd@esap.edu.co
LEGAL_EMAIL_ACCOUNT_CORREOS=

# Redirección global de correos en entornos de desarrollo/pruebas (dejar vacío en producción)
EMAIL_REDIRECT_TO=desarrollo.ccd@esap.edu.co

# SMTP fallback opcional
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=notificaciones@esap.edu.co
# SMTP_PASS=your-email-password
# SMTP_FROM=notificaciones@esap.edu.co

# Oracle FNC integration (certificado laboral)
ORACLE_FNC_ENABLED=false
ORACLE_FNC_USER=
ORACLE_FNC_PASSWORD=""
ORACLE_FNC_CONNECT_STRING=""
ORACLE_FNC_SCHEMA=
ORACLE_FNC_VIEW=

# Oracle SINU - certificados de graduados
ORACLE_GRAD_ENABLED=false
ORACLE_GRAD_USER=
ORACLE_GRAD_PASSWORD=""
ORACLE_GRAD_CONNECT_STRING=""
ORACLE_GRAD_SCHEMA=
ORACLE_GRAD_VIEW=

# MySQL graduados (prioridad antes de Oracle SINU)
MYSQL_GRAD_ENABLED=false
MYSQL_GRAD_HOST=
MYSQL_GRAD_PORT=3306
MYSQL_GRAD_USER=
MYSQL_GRAD_PASSWORD=""
MYSQL_GRAD_DATABASE=
MYSQL_GRAD_VIEW=vw_integracion
MYSQL_GRAD_DOCUMENT_COLUMN=NUM_IDENTIFICACION

# Microsoft Graph API (Email Integration)
VITE_MICROSOFT_TENANT_ID=vite-microsoft-tenant-id
VITE_MICROSOFT_CLIENT_ID=vite-microsoft-client-id

# Valores: "both" muestra Microsoft + correo/contraseña; "microsoft" muestra solo Microsoft.
VITE_LOGIN_OPTIONS="both"
