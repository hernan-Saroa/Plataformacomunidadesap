# =====================================================
# Variables de Entorno para DEV (Desarrollo del equipo)
# Servidor: http://4.156.71.181
# =====================================================

# ============ DATABASE ============
DB_PASSWORD=esap_secure_password_2025

# ============ JWT SECRETS ============
# IMPORTANTE: Cambiar estos valores en producción real
JWT_SECRET=esap_jwt_secret_change_in_production_2024
JWT_REFRESH_SECRET=esap_refresh_secret_change_in_production_2024

# ============ SERVER CONFIG ============
SERVER_IP=4.156.71.181
FRONTEND_URL=http://4.156.71.181
API_URL=http://4.156.71.181:3000

# ============ VITE (Frontend) ============
# IMPORTANTE: Las variables para Vite DEBEN tener prefijo VITE_
VITE_API_URL=http://4.156.71.181:3000

# Puerto publicado por el gateway MFE. En PROD con Nginx SSL en el host,
# deploy.prod.sh usa 127.0.0.1:8080 por defecto para dejar libres 80/443.
# FRONTEND_GATEWAY_BIND=127.0.0.1
# FRONTEND_GATEWAY_PORT=8080

# ============ EMAIL (si aplica) ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@esap.edu.co
SMTP_PASS=your-email-password
SMTP_FROM=noreply@esap.edu.co

# Oracle FNC integration (certificado laboral)
ORACLE_FNC_ENABLED=false
ORACLE_FNC_USER=
ORACLE_FNC_PASSWORD=""
ORACLE_FNC_CONNECT_STRING=""
ORACLE_FNC_SCHEMA=
ORACLE_FNC_VIEW=

# Oracle SINU - certificados de graduados
ORACLE_GRAD_ENABLED=false
ORACLE_GRAD_USER=
ORACLE_GRAD_PASSWORD=""
ORACLE_GRAD_CONNECT_STRING=""
ORACLE_GRAD_SCHEMA=
ORACLE_GRAD_VIEW=

# Microsoft Graph API (Email Integration)
VITE_MICROSOFT_TENANT_ID=vite-microsoft-tenant-id
VITE_MICROSOFT_CLIENT_ID=vite-microsoft-client-id

# Valores: "both" muestra Microsoft + correo/contraseña; "microsoft" muestra solo Microsoft.
VITE_LOGIN_OPTIONS="both"
