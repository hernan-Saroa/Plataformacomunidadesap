# SOLO PARA ACTIVACIÓN FUTURA: no incorporar mientras la HU esté aplazada.
# Incorporar estas variables al .env del ambiente DESPUÉS de respaldar/copiar uploads.
# No contiene ni requiere credenciales de OpenKM para la etapa provisional.
# No sustituir el .env completo: conservar DB, JWT y demás variables existentes.
RUND_DOCUMENTAL_PERSISTENT=true
RUND_DOCUMENTAL_ENABLED=true
RUND_DOCUMENT_PROVIDER=LOCAL
RUND_DOCUMENT_ALLOW_LOCAL=true
RUND_DOCUMENT_LOCAL_ROOT=/app/uploads
RUND_UPLOADS_HOST_PATH=REEMPLAZAR_POR_RUTA_ABSOLUTA_CON_UPLOADS_VERIFICADOS
RUND_POLICY_HOST_PATH=REEMPLAZAR_POR_DIRECTORIO_ABSOLUTO_DE_POLITICAS
RUND_TRD_POLICY_FILE=
RUND_PRIVACY_POLICY_FILE=
# Al activar OpenKM, cambiar PROVIDER a OPENKM y ALLOW_LOCAL a false.
# Agregar OPENKM_BASE_URL, OPENKM_USERNAME y OPENKM_PASSWORD solo al .env privado.
