# syntax=docker/dockerfile:1.4
# Dockerfile para Frontend en DEV Server
# Multi-stage build: Build con Node.js, Serve con Nginx

# ============ STAGE 1: Build ============
FROM node:20-alpine AS builder

WORKDIR /app

# Evita que Puppeteer descargue Chrome/Chromium durante `npm install`.
ENV PUPPETEER_SKIP_DOWNLOAD=1 \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Copiar el frontend completo para que npm detecte todos los workspaces del monorepo
COPY . .

# Instalar dependencias (cachea npm para rebuilds más rápidos)
# Usamos npm install en vez de npm ci para evitar fallar por desalineación de lockfile en entorno dev server.
RUN --mount=type=cache,target=/root/.npm npm install --legacy-peer-deps

# Argumentos para las URLs (se pasan en build time)
ARG VITE_API_URL=/services
ARG VITE_ONLYOFFICE_URL=/onlyoffice
ARG VITE_MICROSOFT_TENANT_ID=
ARG VITE_MICROSOFT_CLIENT_ID=
ARG VITE_LOGIN_OPTIONS=both

# Exportar como variables de entorno Y crear .env.production
# Vite necesita ambas cosas para inyectar las variables correctamente
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_ONLYOFFICE_URL=${VITE_ONLYOFFICE_URL}
ENV VITE_MICROSOFT_TENANT_ID=${VITE_MICROSOFT_TENANT_ID}
ENV VITE_MICROSOFT_CLIENT_ID=${VITE_MICROSOFT_CLIENT_ID}
ENV VITE_LOGIN_OPTIONS=${VITE_LOGIN_OPTIONS}
RUN test -n "${VITE_MICROSOFT_TENANT_ID}" && test -n "${VITE_MICROSOFT_CLIENT_ID}"
RUN echo "VITE_API_URL=${VITE_API_URL}" > .env.production && \
    echo "VITE_ONLYOFFICE_URL=${VITE_ONLYOFFICE_URL}" >> .env.production && \
    echo "VITE_MICROSOFT_TENANT_ID=${VITE_MICROSOFT_TENANT_ID}" >> .env.production && \
    echo "VITE_MICROSOFT_CLIENT_ID=${VITE_MICROSOFT_CLIENT_ID}" >> .env.production && \
    echo "VITE_LOGIN_OPTIONS=${VITE_LOGIN_OPTIONS}" >> .env.production && \
    echo "Contenido de .env.production:" && cat .env.production

# Build de producción (Vite lee .env.production automáticamente)
RUN npm run build && \
    echo "Verificando que el bundle no exponga hosts sensibles..." && \
    if grep -r -E "4\\.156\\.71\\.181|135\\.237\\.81\\.133|172\\.16\\.202\\.169|172\\.16\\.202\\.222|outlook\\.office\\.com|humanosoft\\.esap\\.edu\\.co|arca\\.esap\\.edu\\.co|onlyoffice:80" /app/build/assets/*.js; then exit 1; fi

# ============ STAGE 2: Serve con Nginx ============
FROM nginx:alpine AS production

COPY docker/nginx/nginx.main.conf /etc/nginx/nginx.conf

# Copiar configuración personalizada de nginx
RUN mkdir -p /opt/esap-nginx
COPY nginx.conf /opt/esap-nginx/http.conf
COPY nginx.tls.conf.template /opt/esap-nginx/tls.conf.template
COPY docker/nginx/40-esap-select-config.sh /docker-entrypoint.d/40-esap-select-config.sh
RUN chmod +x /docker-entrypoint.d/40-esap-select-config.sh

# Copiar archivos de build desde el stage anterior
COPY --from=builder /app/build /usr/share/nginx/html

# Exponer puerto 80
EXPOSE 80 443

# Comando por defecto
CMD ["nginx", "-g", "daemon off;"]
