# =====================================================
# Variables de Entorno para Desarrollo LOCAL
# Usa este archivo para correr servicios individuales por terminal
# =====================================================

# Modo de API: 'direct' para conectar directamente a cada microservicio
# Sin pasar por el API Gateway (útil para desarrollo sin Docker)
VITE_API_MODE=direct

# No se necesita VITE_API_URL en modo direct porque cada servicio
# tiene su propia URL definida en environment.ts
