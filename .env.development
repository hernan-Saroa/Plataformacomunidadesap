# =====================================================
# Variables de Entorno para Desarrollo LOCAL
# Usa este archivo para correr servicios individuales por terminal
# =====================================================

# Modo de API: 'gateway' para que el frontend y todos los MFE pasen por el API Gateway.
VITE_API_MODE=gateway

# API Gateway local. El Shell Vite corre en 3000 y el backend gateway en 4000.
VITE_API_URL=http://localhost:4000
